# Copy this file to .env.local and fill in values. Never commit .env.local.
# Variables starting with NEXT_PUBLIC_ are visible in the browser: never put secrets in them.

# Public site address (used for links, sitemap and social previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Friends preview before the official launch: 1 = search engines may not index the site (robots.txt and
# X-Robots-Tag). Set when building. Remove at the official launch.
# CRYPY_PREVIEW=1

# ---- Blockchain data (optional: without them free public nodes are used) ----
# Server-only. Alchemy dashboard → your app → API key.
ALCHEMY_API_KEY=
# Extra FREE providers (zero-API-cost rule), tried after Alchemy and before public nodes.
# Paste each provider's endpoint URL from its dashboard; several URLs on one line, separated by commas.
# Example shape: ETH_RPC_URLS=https://provider-one.example/eth/KEY,https://provider-two.example/KEY
ETH_RPC_URLS=
BSC_RPC_URLS=
BASE_RPC_URLS=
ARBITRUM_RPC_URLS=
POLYGON_RPC_URLS=

# Daily budgets so no free plan runs out (defaults shown; leave empty to use them).
# Alchemy free plan = 30M compute units a month, about 1M a day.
ALCHEMY_DAILY_CU=
RPC_DAILY_REQUESTS=

# ---- Wallet connection ----
# Public (safe in the browser). Reown Cloud → project → Project ID (32 characters).
# In Reown, restrict allowed domains to crypy.org and localhost.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---- Accounts and watchlist (M8) ----
# Not needed on your PC: without DATABASE_URL, CRYPY keeps a local database in .data/pglite (PGlite).
# At launch, on the VPS: DATABASE_URL=postgres://user:password@localhost:5432/crypy
# DATABASE_URL=
# PGLITE_DIR=.data/pglite

# ---- At launch (M9): self-hosted on our own VPS, no paid cloud services ----
# REDIS_URL=redis://…         (Redis on the VPS: shared cache and usage budgets)

# ---- Later milestones ----
# GOPLUS_APP_KEY=                 # M5
# GOPLUS_APP_SECRET=              # M5
# ETHERSCAN_API_KEY=              # M7
# BSCTRACE_API_KEY=               # M7
# ALCHEMY_WEBHOOK_SIGNING_KEY=    # M8

# ---- Alerts (M8 Part 3) ----
# The Telegram bot's token from @BotFather. Server-only; never share it or put it in NEXT_PUBLIC_ variables.
# Only one running server may use a token at a time (Telegram allows one reader per bot).
TELEGRAM_BOT_TOKEN=
# The background checker and the bot run inside the server. Set to off to stop both (for example on a second server).
# CRYPY_WORKER=on

# ---- Admin dashboard (M9 Part 5) ----
# Wallet addresses that may open /admin after signing in with that wallet (comma-separated public addresses, never
# keys). Leave empty and nobody can open it. On the server, put your own wallet address here.
# ADMIN_WALLETS=0xYourWalletAddress
